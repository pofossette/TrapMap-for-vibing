TRAPMAP_SYSTEM_ADMIN_KEY=replace-with-a-long-random-secret
TRAPMAP_DATA_FILE=.data/skill-shareer.json
HOST=127.0.0.1
PORT=4000
RUNTIME_MODE=combined
LOG_LEVEL=info

# --------------------------------------------
# Deployment Profile / Gateway / Transport
# --------------------------------------------
# Formal deployment profile: local-agent | team-monolith | distributed
TRAPMAP_DEPLOYMENT_PROFILE=team-monolith

# Compose defaults:
# - `docker compose up -d` => team-monolith gateway
# - `docker compose --profile distributed up -d` => gateway + candidate/governance/outbox workers
# - `docker compose --profile distributed --profile mq up -d` => distributed workers + RabbitMQ transport option

# Compatibility startup shortcut. Leave unset when using profile-named scripts.
# Valid presets: monolith | api | candidate-worker | governance-worker | outbox-worker
# TRAPMAP_DEPLOYMENT_PRESET=monolith

# CLI only talks to the gateway URL; backend service split stays transparent to CLI.
TRAPMAP_GATEWAY_URL=http://127.0.0.1:4000

# Async task transport. Recommended defaults:
# - local-agent: postgres
# - team-monolith: postgres
# - distributed: postgres first, rabbitmq only when you need separate task scaling
TRAPMAP_TASK_TRANSPORT=postgres

# Optional explicit ownership override for worker runtimes.
# TRAPMAP_SERVICE_UNIT=full-platform

# --------------------------------------------
# Required API Keys
# --------------------------------------------
# OpenAI API key (required for default provider)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional Google GenAI key (auto-detects google-genai when set and OPENAI_API_KEY is absent)
# GEMINI_API_KEY=your-gemini-api-key-here

# --------------------------------------------
# Database (optional, for production)
# --------------------------------------------
# When set, uses PostgreSQL instead of JSON file storage
# TRAPMAP_DATABASE_URL=postgresql://trapmap:password@localhost:5432/trapmap

# Optional DB-search gate
# USE_DB_SEARCH=false

# --------------------------------------------
# User Operations Logging (Phase 21)
# --------------------------------------------
# Enable user operations logging to files
LOG_USER_OPS_ENABLED=false

# Directory for user ops log files (default: logs/user-ops)
# LOG_USER_OPS_DIR=logs/user-ops

# --------------------------------------------
# RAG Logging (Phase 22)
# --------------------------------------------
# Enable RAG retrieval logging to files
LOG_RAG_ENABLED=false

# Directory for RAG log files (default: logs/rag)
# LOG_RAG_DIR=logs/rag

# --------------------------------------------
# Log Rotation (Phase 22)
# --------------------------------------------
# Maximum log file size in MB before rotation (default: 10)
# LOG_MAX_FILE_SIZE_MB=10

# Maximum number of backup files per day (default: 5)
# LOG_MAX_BACKUP_FILES=5

# --------------------------------------------
# Decay Configuration (optional)
# --------------------------------------------
# TRAPMAP_DECAY_ENABLED=false
# TRAPMAP_DECAY_REVIEW_DUE_DAYS=90
# TRAPMAP_DECAY_STALE_DAYS=180
# TRAPMAP_DECAY_EXPIRE_DAYS=365

# --------------------------------------------
# AI Provider (optional)
# --------------------------------------------
# Provider: openai | openai-compatible | ollama | google-genai
# If not set, auto-detects from OPENAI_API_KEY or GEMINI_API_KEY
# AI_PROVIDER=google-genai

# API base URL (default varies by provider)
# - openai: https://api.openai.com/v1
# - google-genai: https://generativelanguage.googleapis.com/v1beta
# AI_BASE_URL=https://api.openai.com/v1

# API key (default: OPENAI_API_KEY for openai, GEMINI_API_KEY for google-genai)
# AI_API_KEY=your-key-here

# Chat model (default: gpt-4o-mini for openai, gemini-2.0-flash for google-genai)
# AI_CHAT_MODEL=gemini-2.0-flash

# Embedding model (default: text-embedding-3-small for openai, text-embedding-004 for google-genai)
# AI_EMBEDDING_MODEL=text-embedding-004

# Prompt provider selection (optional)
# Controls which template format (XML/JSON) and cache strategy is used.
# Valid values: anthropic, openai, deepseek, kimi, gemini, default
# If not set, the provider is auto-detected from the model ID (e.g. "claude-*" → anthropic).
# See docs/archived/operations/PROMPT_PROVIDERS.md for details.
# AI_PROMPT_PROVIDER=anthropic

# Slot override file (optional)
# JSON file that overrides specific prompt slot values per task type.
# System prompts are always rendered as XML (四层架构：XML=内容标记层).
# Template overrides are loaded from a JSON file (JSON=传输协议层).
# See docs/archived/reference/xml-system-prompt-methodology.md for the four-layer architecture.
# AI_PROMPT_TEMPLATE_FILE=docs/reference/system-prompt-slots.default.json

# --------------------------------------------
# Separate Embedding Provider (optional)
# --------------------------------------------
# Use a different provider for embeddings than chat
# EMBEDDING_PROVIDER=google-genai
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_API_KEY=your-gemini-api-key
# EMBEDDING_MODEL=text-embedding-004

# --------------------------------------------
# Optional Graph Query Backend (Neo4j)
# --------------------------------------------
# TRAPMAP_GRAPH_DB_ENABLED=false
# TRAPMAP_GRAPH_DB_PROVIDER=neo4j
# TRAPMAP_GRAPH_DB_URI=bolt://127.0.0.1:7687
# TRAPMAP_GRAPH_DB_USERNAME=neo4j
# TRAPMAP_GRAPH_DB_PASSWORD=change-me
# TRAPMAP_GRAPH_DB_DATABASE=neo4j
# TRAPMAP_GRAPH_DB_FAIL_OPEN=true
# TRAPMAP_GRAPH_DB_SYNC_ON_WRITE=true
