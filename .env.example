TRAPMAP_SYSTEM_ADMIN_KEY=replace-with-a-long-random-secret
TRAPMAP_DATA_FILE=.data/trapmap.json
HOST=127.0.0.1
PORT=4000

# --------------------------------------------
# User Operations Logging (Phase 21)
# --------------------------------------------
# Enable user operations logging to files
LOG_USER_OPS_ENABLED=false

# Directory for user ops log files (default: logs/user-ops)
# LOG_USER_OPS_DIR=logs/user-ops

# --------------------------------------------
# RAG Logging (Phase 22)
# --------------------------------------------
# Enable RAG retrieval logging to files
LOG_RAG_ENABLED=false

# Directory for RAG log files (default: logs/rag)
# LOG_RAG_DIR=logs/rag

# --------------------------------------------
# Log Rotation (Phase 22)
# --------------------------------------------
# Maximum log file size in MB before rotation (default: 10)
# LOG_MAX_FILE_SIZE_MB=10

# Maximum number of backup files per day (default: 5)
# LOG_MAX_BACKUP_FILES=5

# --------------------------------------------
# AI Provider (optional)
# --------------------------------------------
# Provider: openai | openai-compatible | ollama | google-genai
# If not set, auto-detects from OPENAI_API_KEY or GEMINI_API_KEY
# AI_PROVIDER=google-genai

# API base URL (default varies by provider)
# - openai: https://api.openai.com/v1
# - google-genai: https://generativelanguage.googleapis.com/v1beta
# AI_BASE_URL=https://api.openai.com/v1

# API key (default: OPENAI_API_KEY for openai, GEMINI_API_KEY for google-genai)
# AI_API_KEY=your-key-here

# Chat model (default: gpt-4o-mini for openai, gemini-2.0-flash for google-genai)
# AI_CHAT_MODEL=gemini-2.0-flash

# Embedding model (default: text-embedding-3-small for openai, text-embedding-004 for google-genai)
# AI_EMBEDDING_MODEL=text-embedding-004

# --------------------------------------------
# Separate Embedding Provider (optional)
# --------------------------------------------
# Use a different provider for embeddings than chat
# EMBEDDING_PROVIDER=google-genai
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_API_KEY=your-gemini-api-key
# EMBEDDING_MODEL=text-embedding-004
