{
  "docRules": [
    {
      "file": "docs/guides/CODE_GUIDE.md",
      "mustContain": [
        "buildServer()",
        "packages/server/src/lib/README.md",
        "packages/server/src/routes/README.md"
      ],
      "mustNotContain": ["createApp()"]
    },
    {
      "file": "docs/architecture/ARCHITECTURE.md",
      "mustContain": ["SYSTEM_TRUTH_SOURCES.md", "127.0.0.1", "gpt-4o-mini"],
      "mustNotContain": ["| `HOST` | `0.0.0.0` |", "| `AI_CHAT_MODEL` | `gpt-4o` |"]
    },
    {
      "file": "docs/reference/SYSTEM_TRUTH_SOURCES.md",
      "mustContain": [
        "Six-service ownership boundary",
        "review` owns governance queue/decision/feedback/maintenance/decay commands but must delegate final aggregate mutation through `KnowledgeWritePort`",
        "candidate-ingestion` owns candidate workflow facts but must publish resolved results through `KnowledgeWritePort`"
      ]
    },
    {
      "file": "docs/architecture/ARCHITECTURE.md",
      "mustContain": [
        "Phase 5 六服务 ownership 冻结补充事实",
        "`knowledge-write` 拥有 knowledge/trap/evidence 写模型真相",
        "`job-runtime` 只拥有 queue/outbox/worker/retry/reclaim/status 等 runtime 编排",
        "`packages/server` 当前是 compatibility shell 与 runtime/status surface"
      ]
    },
    {
      "file": "docs/guides/MIGRATION_GUIDE.md",
      "mustContain": [
        "compatibility shell",
        "distributed mode",
        "explicit `local-agent` / `team-monolith` rollback path"
      ]
    },
    {
      "file": "docs/reference/SYSTEM_TRUTH_SOURCES.md",
      "mustContain": [
        "`packages/server` 是 Fastify compatibility shell 与 shared runtime/status seam，不再承担默认 light 宿主职责，也不再提供本地宿主 rollback 入口。"
      ]
    },
    {
      "file": "docs/reference/REPO_STRUCTURE.md",
      "mustContain": [
        "`docs/plans/`: historical design references and only active again when a current root plan explicitly re-links them.",
        "`docs/todos/`: pending work plus the phase detail docs linked from the current root `plan.md`."
      ]
    },
    {
      "file": "docs/README.md",
      "mustNotContain": ["使用 JSON 文件存储", "48 张表", "54 张表"]
    },
    {
      "file": "docs/guides/GETTING_STARTED.md",
      "mustContain": [
        "PostgreSQL 设置（默认）",
        ".data/skill-shareer.json",
        "pnpm --filter @trapmap/server db:migrate"
      ],
      "mustNotContain": [
        "PostgreSQL 模式（可选）",
        ".data/trapmap.json",
        "pnpm run db:migrate",
        "pnpm run db:generate"
      ]
    },
    {
      "file": "docs/architecture/DEPLOYMENT.md",
      "mustContain": [
        "TRAPMAP_DATABASE_URL",
        "gpt-4o-mini",
        ".data/skill-shareer.json",
        "仓库当前未包含 Helm chart"
      ],
      "mustNotContain": ["使用 JSON 文件存储", "DEBUG=false", "SESSION_SECRET"],
      "mustNotContainRegex": ["gpt-4o(?!-)"],
      "mustContainCount": {
        "pattern": "PostgreSQL",
        "minOccurrences": 3
      }
    },
    {
      "file": "docs/reference/DATABASE_SCHEMA.md",
      "mustContain": ["57 张表"],
      "mustNotContain": ["48 张表", "54 张表", "56 张表"]
    },
    {
      "file": "docs/operations/ENVIRONMENT.md",
      "mustContain": [".data/skill-shareer.json"],
      "mustNotContain": [".data/trapmap.json"]
    },
    {
      "file": "docs/architecture/components/PERSISTENCE.md",
      "mustContain": ["57 张表", ".data/skill-shareer.json"],
      "mustNotContain": ["48 张表", "56 张表"]
    },
    {
      "file": "docs/guides/CONTRIBUTING.md",
      "mustContain": [
        "pnpm --filter @trapmap/server db:generate",
        "pnpm --filter @trapmap/server db:migrate"
      ],
      "mustNotContain": ["pnpm run db:generate", "pnpm run db:migrate"]
    },
    {
      "file": "docs/operations/TESTING.md",
      "mustContain": ["pnpm eval:ci:core"],
      "mustNotContain": ["TIER=core pnpm eval:ci"]
    },
    {
      "file": "docs/architecture/components/EVALUATION.md",
      "mustContain": ["pnpm eval:smoke", "pnpm eval:core"],
      "mustNotContain": ["pnpm eval:governance"]
    },
    {
      "file": "docs/operations/ENVIRONMENT.md",
      "mustContain": ["fallback", "OPENAI_API_KEY", "GEMINI_API_KEY", "未暴露为稳定 CLI 命令"],
      "mustNotContain": ["默认 openai"]
    },
    {
      "file": "docs/architecture/components/AI_PROVIDER.md",
      "mustContain": ["fallback", "google-genai", "gpt-4o-mini", "llama3"],
      "mustNotContain": ["默认 openai", "llama2"]
    },
    {
      "file": "docs/architecture/ARCHITECTURE.md",
      "mustContain": ["pgvector/pgvector:pg16", "wget"],
      "mustNotContain": ["image: postgres:16", "curl.*-f.*health"]
    },
    {
      "file": "docs/architecture/components/EVALUATION.md",
      "mustContain": ["datasets/", "scenarios/"],
      "mustNotContain": ["cases/"]
    },
    {
      "file": "docs/architecture/components/ASYNC_INFRASTRUCTURE.md",
      "mustNotContain": ["DualWriteKnowledgeRepository", "DualWriteArtifactRepository"]
    },
    {
      "file": "docs/architecture/components/ARTIFACTS.md",
      "mustContain": ["agent-pass", "SkillArtifactRecord"],
      "mustNotContain": ["interface SkillArtifact {"]
    },
    {
      "file": "evals/README.md",
      "mustContain": ["retrieval/", "summary/", "graph-extraction/", "ingestion/", "pnpm eval:ci"]
    },
    {
      "file": "docs/README.md",
      "mustContain": ["Nest modular monolith"],
      "mustNotContain": ["NestJS 是后续宿主替换目标"]
    },
    {
      "file": "docs/architecture/DEPLOYMENT.md",
      "mustContain": ["Nest modular monolith 主线", "compatibility shell"],
      "mustNotContain": []
    },
    {
      "file": "docs/operations/TESTING.md",
      "mustContain": ["Phase 4 验证归属矩阵"]
    },
    {
      "file": "docs/PACKAGES.md",
      "mustContain": ["Phase 4 数据、运维与退役收尾", "packages/host-local/src/nest/**"],
      "mustNotContain": ["packages/host-distributed 是 compatibility shell"]
    },
    {
      "file": "docs/operations/ENVIRONMENT.md",
      "mustContain": ["默认 `light` 主线"],
      "mustNotContain": ["Phase 1 试点"]
    }
  ],
  "lineBudgets": [
    { "file": "packages/server/src/app.ts", "maxLines": 350 },
    { "file": "packages/server/src/routes/candidates.ts", "maxLines": 150 },
    { "file": "packages/server/src/lib/persistence/schema.ts", "maxLines": 200 },
    { "file": "packages/server/src/lib/artifacts/pg-repository.ts", "maxLines": 250 }
  ]
}
