{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "preset": "recommended",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "preset": "recommended",
        "noExplicitAny": "off"
      },
      "complexity": {
        "preset": "recommended"
      },
      "style": {
        "preset": "recommended",
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "preset": "recommended"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/node_modules",
      "!**/.pnpm-store",
      "!**/data",
      "!**/.tmp",
      "!**/temp",
      "!**/.data",
      "!**/.agent",
      "!**/.claude",
      "!**/.codex",
      "!**/.gemini",
      "!**/.kilo",
      "!**/.opencode",
      "!**/reports",
      "!**/.vitest",
      "!**/benchmarks/results",
      "!**/packages/**/*/src/**/*.js",
      "!**/packages/**/*/src/**/*.js.map",
      "!**/packages/**/*/src/**/*.d.ts",
      "!**/packages/**/*/src/**/*.d.ts.map",
      "!**/scripts/codemods"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
