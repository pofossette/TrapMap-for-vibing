{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/backend-core/src/index.ts",
    "packages/assembly/src/index.ts",
    "packages/lib/src/index.ts",
    "apps/cli/src/index.ts",
    "apps/mcp/src/index.ts",
    "packages/client-core/src/index.ts",
    "packages/contracts/src/index.ts",
    "packages/persistence-schema/src/index.ts",
    "packages/host-distributed/src/index.ts",
    "packages/host-local/src/index.ts",
    "apps/web-panel/index.html",
    "apps/web-panel/src/main.tsx",
    "scripts/*.ts",
    "scripts/*.mjs",
    "apps/cli/src/testing/index.ts",
    "evals/**/*.ts"
  ],
  "ignoreDependencies": ["amqplib", "markdown-link-check"],
  "usedClassMembers": [
    {
      "implements": "EmbeddingsProvider",
      "members": ["embed"]
    }
  ],
  "duplicates": {
    "enabled": true,
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 2,
    "threshold": 0,
    "ignore": [],
    "ignoreDefaults": true,
    "skipLocal": false,
    "crossLanguage": false,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "crapRefactorBand": 5,
    "ignore": [],
    "suggestInlineSuppression": true
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-class-members": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.fallow/**",
    "**/*.generated.*",
    "reports/**",
    "data/**",
    "graphify-out/**",
    "scripts/archived/**",
    "packages/skills"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "contracts",
        "patterns": ["packages/contracts/src/**"]
      },
      {
        "name": "lib",
        "patterns": ["packages/lib/src/**"]
      },
      {
        "name": "persistence-schema",
        "patterns": ["packages/persistence-schema/src/**"]
      },
      {
        "name": "client-core",
        "patterns": ["packages/client-core/src/**"]
      },
      {
        "name": "ai-providers",
        "patterns": ["packages/ai-providers/src/**"]
      },
      {
        "name": "backend-core",
        "patterns": ["packages/backend-core/src/**"]
      },
      {
        "name": "assembly",
        "patterns": ["packages/assembly/src/**"]
      },
      {
        "name": "service-standard",
        "patterns": [
          "packages/service-identity-access/src/**",
          "packages/service-candidate-ingestion/src/**",
          "packages/service-governance-review/src/**",
          "packages/service-job-runtime/src/**",
          "packages/service-knowledge-write/src/**",
          "packages/service-cron/src/**"
        ]
      },
      {
        "name": "service-knowledge-read",
        "patterns": ["packages/service-knowledge-read/src/**"]
      },
      {
        "name": "host-local",
        "patterns": ["packages/host-local/src/**"]
      },
      {
        "name": "host-distributed",
        "patterns": ["packages/host-distributed/src/**"]
      },
      {
        "name": "cli",
        "patterns": ["apps/cli/src/**"]
      },
      {
        "name": "web-panel",
        "patterns": ["apps/web-panel/src/**"]
      },
      {
        "name": "mcp",
        "patterns": ["apps/mcp/src/**"]
      }
    ],
    "rules": [
      {
        "from": "contracts",
        "allow": []
      },
      {
        "from": "lib",
        "allow": ["contracts"]
      },
      {
        "from": "persistence-schema",
        "allow": ["contracts"]
      },
      {
        "from": "client-core",
        "allow": []
      },
      {
        "from": "backend-core",
        "allow": ["contracts", "persistence-schema", "lib"]
      },
      {
        "from": "assembly",
        "allow": ["backend-core", "contracts", "lib"]
      },
      {
        "from": "ai-providers",
        "allow": ["contracts", "lib"]
      },
      {
        "from": "service-standard",
        "allow": ["ai-providers", "backend-core", "contracts", "persistence-schema", "lib"]
      },
      {
        "from": "service-knowledge-read",
        "allow": ["ai-providers", "backend-core", "contracts", "persistence-schema", "lib"]
      },
      {
        "from": "host-local",
        "allow": [
          "contracts",
          "client-core",
          "ai-providers",
          "backend-core",
          "assembly",
          "service-standard",
          "service-knowledge-read",
          "persistence-schema",
          "lib"
        ]
      },
      {
        "from": "host-distributed",
        "allow": [
          "contracts",
          "client-core",
          "ai-providers",
          "backend-core",
          "assembly",
          "service-standard",
          "service-knowledge-read",
          "persistence-schema",
          "lib"
        ]
      },
      {
        "from": "cli",
        "allow": ["client-core", "contracts", "lib"]
      },
      {
        "from": "web-panel",
        "allow": ["client-core", "contracts"]
      },
      {
        "from": "mcp",
        "allow": ["client-core", "contracts", "lib"]
      }
    ],
    "coverage": {
      "requireAllFiles": false,
      "allowUnmatched": ["scripts/**", "evals/**", "packages/skills/**"]
    }
  }
}
