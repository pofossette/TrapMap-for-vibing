{
  "name": "trapmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "ci": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-ci.ts",
    "dev:cli": "pnpm --filter @trapmap/cli dev",
    "dev:server": "pnpm --filter @trapmap/server dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check": "biome check .",
    "check:docs-drift": "pnpm exec tsx scripts/check-doc-drift.ts",
    "check:mermaid": "pnpm exec tsx scripts/check-mermaid.ts",
    "check:structure": "node scripts/check-structure.mjs",
    "check:complexity": "pnpm exec tsx scripts/check-complexity-budgets.ts",
    "test:runtime-foundations": "vitest run packages/server/src/app.test.ts packages/server/src/lib/runtime/runtime-metadata.test.ts packages/server/src/lib/runtime/resilience.test.ts packages/server/src/lib/runtime/metrics.test.ts packages/server/src/lib/candidates/processor.test.ts packages/server/src/bootstrap/startup.test.ts packages/server/src/lib/indexing/graph-lite/llm-extract.test.ts packages/server/src/lib/queue/task-queue.test.ts packages/server/src/lib/lifecycle/outbox.test.ts packages/server/src/__tests__/candidate-pipeline.test.ts packages/server/src/lib/lifecycle/subscribers/subscribers-integration.test.ts packages/server/src/routes/candidates.test.ts packages/server/src/__tests__/docs-truth-smoke.test.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "eval:retrieval": "pnpm exec tsx --tsconfig tsconfig.base.json evals/retrieval/run.ts",
    "eval:retrieval:smoke": "pnpm exec tsx --tsconfig tsconfig.base.json evals/retrieval/run.ts --tier smoke",
    "eval:retrieval:core": "pnpm exec tsx --tsconfig tsconfig.base.json evals/retrieval/run.ts --tier core",
    "eval:retrieval:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json evals/retrieval/run.ts --tier smoke --dry-run",
    "eval:summary": "pnpm exec tsx --tsconfig tsconfig.base.json evals/summary/run.ts",
    "eval:summary:smoke": "pnpm exec tsx --tsconfig tsconfig.base.json evals/summary/run.ts --tier smoke",
    "eval:summary:core": "pnpm exec tsx --tsconfig tsconfig.base.json evals/summary/run.ts --tier core",
    "eval:summary:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json evals/summary/run.ts --tier smoke --dry-run",
    "eval:smoke": "pnpm exec tsx --tsconfig tsconfig.base.json evals/scripts/eval-all.ts --tier smoke",
    "eval:graph-extraction": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/run.ts",
    "eval:graph-extraction:smoke": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/run.ts --smoke",
    "eval:graph-extraction:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/run.ts --smoke --dry-run",
    "eval:dedup": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/dedup-eval.ts",
    "eval:dedup:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/dedup-eval.ts --dry-run",
    "eval:conflict": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/conflict-eval.ts",
    "eval:conflict:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/conflict-eval.ts --dry-run",
    "eval:ingestion": "pnpm exec tsx --tsconfig tsconfig.base.json evals/ingestion/run.ts",
    "eval:ingestion:smoke": "pnpm exec tsx --tsconfig tsconfig.base.json evals/ingestion/run.ts --smoke",
    "eval:ingestion:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json evals/ingestion/run.ts --dry-run --smoke",
    "eval:core": "pnpm exec tsx --tsconfig tsconfig.base.json evals/scripts/eval-all.ts --tier core",
    "eval:all": "pnpm exec tsx --tsconfig tsconfig.base.json evals/scripts/eval-all.ts --tier core",
    "eval:all:json": "pnpm exec tsx --tsconfig tsconfig.base.json evals/scripts/eval-all.ts --tier core --json --json-path ./reports/eval-report.json",
    "eval:ci": "pnpm exec tsx --tsconfig tsconfig.base.json evals/scripts/eval-ci.ts",
    "eval:ci:core": "TIER=core pnpm exec tsx --tsconfig tsconfig.base.json evals/scripts/eval-ci.ts",
    "download:skills": "pnpm exec tsx scripts/batch-download-skills.ts",
    "download:skills:dry": "pnpm exec tsx scripts/batch-download-skills.ts --dry-run --verbose",
    "test:import-export": "pnpm exec tsx scripts/test-skill-import-export.ts",
    "bench:store": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/bench-store.ts",
    "rag:analyze": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/rag-analyze.ts",
    "check:imports": "node scripts/check-relative-imports.mjs --only-cross-dir",
    "codemod:relative": "FIX_IMPORTS_HEAP_MB=4096 bash scripts/codemod-batch.sh",
    "codemod:relative:dry": "bash scripts/codemod-batch.sh --dry",
    "deploy": "bash scripts/deploy.sh",
    "deploy:quick": "bash scripts/deploy-quick.sh",
    "backfill:labels": "pnpm exec tsx --tsconfig tsconfig.base.json packages/server/src/lib/labels/backfill-runner.ts",
    "backfill:labels:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json packages/server/src/lib/labels/backfill-runner.ts --dry-run",
    "label-merge:repair": "pnpm exec tsx --tsconfig tsconfig.base.json packages/server/src/lib/labels/merge-repair-runner.ts",
    "label-merge:repair:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json packages/server/src/lib/labels/merge-repair-runner.ts --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jscodeshift": "^17.3.0",
    "jsdom": "^29.1.1",
    "knip": "^6.4.1",
    "mermaid": "^11.15.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
