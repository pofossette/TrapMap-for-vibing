{
  "name": "trapmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "build:light": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-backend-target.ts build light",
    "build:heavy": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-backend-target.ts build heavy",
    "ci": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-ci.ts",
    "prepare": "husky",
    "dev": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-dev.ts",
    "dev:cli": "pnpm --filter @trapmap/cli dev",
    "dev:local-agent": "pnpm run dev -- local-agent",
    "dev:team-monolith": "pnpm run dev -- team-monolith",
    "dev:distributed:gateway": "pnpm run dev -- distributed:gateway",
    "dev:distributed:candidate-worker": "pnpm run dev -- distributed:candidate-worker",
    "dev:distributed:governance-worker": "pnpm run dev -- distributed:governance-worker",
    "dev:distributed:outbox-worker": "pnpm run dev -- distributed:outbox-worker",
    "dev:host-local": "pnpm --filter @trapmap/app-light dev",
    "dev:host-distributed": "pnpm --filter @trapmap/app-distributed dev",
    "dev:host-distributed:gateway": "pnpm --filter @trapmap/app-distributed start:gateway",
    "dev:host-distributed:identity-access": "pnpm --filter @trapmap/app-distributed start:identity-access",
    "dev:host-distributed:knowledge-read": "pnpm --filter @trapmap/app-distributed start:knowledge-read",
    "dev:host-distributed:knowledge-write": "pnpm --filter @trapmap/app-distributed start:knowledge-write",
    "dev:host-distributed:candidate-ingestion": "pnpm --filter @trapmap/app-distributed start:candidate-ingestion",
    "dev:host-distributed:governance-review": "pnpm --filter @trapmap/app-distributed start:governance-review",
    "dev:host-distributed:job-runtime": "pnpm --filter @trapmap/app-distributed start:job-runtime",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "fallow": "fallow",
    "check:fallow": "pnpm exec fallow --ci --fail-on-issues",
    "check": "biome check .",
    "check:docs": "pnpm exec tsx scripts/check-docs.ts",
    "check:skills": "pnpm exec tsx scripts/check-skills.ts",
    "check:structure": "pnpm exec tsx scripts/check-structure.ts",
    "check:complexity": "pnpm exec tsx scripts/check-complexity-budgets.ts",
    "duplication": "jscpd --config .jscpd.json packages apps scripts evals",
    "check:asserts": "pnpm exec tsx scripts/check-naked-asserts.ts",
    "check:table-schema": "pnpm exec tsx scripts/check-table-schema.ts",
    "check:pgtable-single-source": "pnpm exec tsx scripts/check-pgtable-single-source.ts",
    "check:eval-imports": "pnpm exec tsx scripts/check-eval-imports.ts",
    "check:eval-only": "pnpm exec tsx scripts/check-eval-only.ts",
    "test:distributed-acceptance": "pnpm --filter @trapmap/host-distributed test:acceptance",
    "test:light-target": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-backend-target.ts test light",
    "test:heavy-target": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-backend-target.ts test heavy",
    "test:observability-closeout": "vitest run packages/host-local/test/nest/health/health.controller.test.ts packages/host-local/test/nest/observability/observability-chain.test.ts packages/host-local/test/nest/observability/prometheus.service.test.ts packages/contracts/src/domain/log-schema.test.ts packages/host-local/test/nest/observability/langfuse.service.test.ts packages/contracts/src/domain/observability-config.test.ts packages/ai-providers/src/observability.test.ts packages/host-local/test/nest/observability/langfuse-sink.test.ts",
    "test:observability-benchmark": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/observability-benchmark.ts",
    "test:discovery-closeout": "vitest run packages/host-distributed/test/gateway/consul-discovery-adapter.test.ts packages/host-distributed/test/gateway/discovery-resolver.test.ts packages/backend-core/test/runtime/dynamic-discovery.test.ts",
    "test:distributed-closeout": "vitest run --project host-distributed packages/host-distributed/test/gateway/distributed-acceptance.test.ts packages/host-distributed/test/gateway/distributed-runtime-closeout.test.ts packages/host-distributed/test/gateway/internal-client.test.ts packages/host-distributed/test/shared/internal-knowledge-write-client.test.ts packages/host-distributed/test/job-runtime/ownership-acceptance.test.ts",
    "test:runtime-closeout": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/runtime-closeout.ts",
    "test:cluster-ownership": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/cluster-ownership.ts",
    "test:runtime-closeout:compose": "bash scripts/run-compose-runtime-closeout.sh",
    "test:runtime-foundations": "pnpm exec vitest run packages/host-local/test/nest/runtime packages/host-distributed/test/gateway",
    "test:deployment-smoke": "pnpm exec vitest run packages/host-local/test/nest packages/host-distributed/test/gateway apps/cli/test/lib/http.test.ts apps/cli/test/commands/auth.test.ts apps/cli/test/commands/retrieval.test.ts",
    "test": "vitest run",
    "test:file": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-vitest-file.ts",
    "test:coverage": "vitest run --coverage --reporter=default --silent=true",
    "typecheck": "tsc -b --pretty false",
    "download:skills": "pnpm exec tsx scripts/batch-download-skills.ts",
    "download:skills:dry": "pnpm exec tsx scripts/batch-download-skills.ts --dry-run --verbose",
    "test:import-export": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/test-skill-import-export.ts",
    "check:imports": "node scripts/check-relative-imports.mjs --only-cross-dir",
    "check:deps": "depcruise --config .dependency-cruiser.cjs packages/*/src",
    "docs:api": "typedoc",
    "deploy": "bash scripts/deploy.sh",
    "deploy:quick": "bash scripts/deploy-quick.sh",
    "generate:contracts": "pnpm --filter @trapmap/contracts exec tsx scripts/generate-json-schema.ts",
    "generate:contracts:check": "pnpm --filter @trapmap/contracts exec tsx scripts/generate-json-schema.ts --check",
    "generate:go-accelerator": "pnpm generate:contracts",
    "check:go-contract": "pnpm exec tsx scripts/check-go-contract-alignment.ts --check && pnpm generate:openapi:check",
    "generate:openapi": "pnpm --filter @trapmap/contracts exec tsx scripts/generate-openapi.ts",
    "generate:openapi:check": "pnpm --filter @trapmap/contracts exec tsx scripts/generate-openapi.ts --check",
    "generate:proto": "buf generate --template buf.gen.yaml || echo 'buf not installed, skip'",
    "generate:proto:check": "buf lint && buf breaking --against origin/main || echo 'buf check skip (no buf)'",
    "dev:web": "pnpm --filter @trapmap/web-panel dev",
    "test:cli-integration": "bash scripts/cli-integration-run.sh",
    "test:cli-integration:dry": "bash scripts/cli-integration-run.sh --runs 1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@trapmap/ai-providers": "workspace:*",
    "@trapmap/service-knowledge-read": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "promptfoo": "0.122.2",
    "zod": "^4.1.12",
    "dependency-cruiser": "^18.0.0",
    "fallow": "^3.22.0",
    "fastify": "^5.6.1",
    "husky": "^9.1.7",
    "jscodeshift": "^17.3.0",
    "jscpd": "^5.0.15",
    "jsdom": "^30.0.1",
    "knip": "^6.4.1",
    "langfuse": "3.38.20",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli2": "^0.23.2",
    "mermaid": "^11.15.0",
    "pg": "8.23.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
