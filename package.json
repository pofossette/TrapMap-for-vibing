{
  "name": "trapmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "ci": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-ci.ts",
    "prepare": "husky",
    "dev": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-dev.ts",
    "dev:cli": "pnpm --filter @trapmap/cli dev",
    "dev:local-agent": "pnpm run dev -- local-agent",
    "dev:team-monolith": "pnpm run dev -- team-monolith",
    "dev:distributed:gateway": "pnpm run dev -- distributed:gateway",
    "dev:distributed:candidate-worker": "pnpm run dev -- distributed:candidate-worker",
    "dev:distributed:governance-worker": "pnpm run dev -- distributed:governance-worker",
    "dev:distributed:outbox-worker": "pnpm run dev -- distributed:outbox-worker",
    "dev:host-local": "pnpm --filter @trapmap/host-local dev",
    "dev:host-local:nest": "pnpm --filter @trapmap/host-local dev:nest",
    "dev:host-distributed": "pnpm --filter @trapmap/host-distributed dev",
    "dev:host-distributed:gateway": "pnpm --filter @trapmap/host-distributed start:gateway",
    "dev:host-distributed:identity-access": "pnpm --filter @trapmap/host-distributed start:identity-access",
    "dev:host-distributed:knowledge-read": "pnpm --filter @trapmap/host-distributed start:knowledge-read",
    "dev:host-distributed:knowledge-write": "pnpm --filter @trapmap/host-distributed start:knowledge-write",
    "dev:host-distributed:candidate-ingestion": "pnpm --filter @trapmap/host-distributed start:candidate-ingestion",
    "dev:host-distributed:governance-review": "pnpm --filter @trapmap/host-distributed start:governance-review",
    "dev:host-distributed:job-runtime": "pnpm --filter @trapmap/host-distributed start:job-runtime",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "fallow": "fallow",
    "check": "biome check .",
    "check:docs-drift": "pnpm exec tsx scripts/check-doc-drift.ts",
    "check:mermaid": "pnpm exec tsx scripts/check-mermaid.ts",
    "check:structure": "node scripts/check-structure.mjs",
    "check:complexity": "pnpm exec tsx scripts/check-complexity-budgets.ts",
    "check:arch-freeze": "pnpm exec tsx scripts/check-arch-freeze.ts",
    "test:distributed-acceptance": "pnpm --filter @trapmap/host-distributed test:acceptance",
    "test:observability-closeout": "vitest run packages/host-local/src/nest/health/health.controller.test.ts packages/host-local/src/nest/observability/observability-chain.test.ts packages/host-local/src/nest/observability/prometheus.service.test.ts packages/contracts/src/domain/log-schema.test.ts",
    "test:observability-benchmark": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/observability-benchmark.ts",
    "test:discovery-closeout": "vitest run packages/host-distributed/src/gateway/consul-discovery-adapter.test.ts packages/host-distributed/src/gateway/discovery-resolver.test.ts packages/backend-core/src/discovery/cached-discovery.test.ts packages/backend-core/src/discovery/round-robin-selector.test.ts",
    "test:distributed-closeout": "vitest run --project host-distributed packages/host-distributed/src/gateway/distributed-acceptance.test.ts packages/host-distributed/src/gateway/distributed-runtime-closeout.test.ts packages/host-distributed/src/gateway/internal-client.test.ts packages/host-distributed/src/shared/internal-knowledge-write-client.test.ts packages/host-distributed/src/job-runtime/ownership-acceptance.test.ts",
    "test:runtime-closeout": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/runtime-closeout.ts",
    "test:runtime-foundations": "vitest run packages/server/src/app.test.ts packages/server/src/lib/runtime/runtime-metadata.test.ts packages/server/src/lib/runtime/resilience.test.ts packages/server/src/lib/runtime/metrics.test.ts packages/server/src/lib/candidates/processor.test.ts packages/server/src/bootstrap/startup.test.ts packages/server/src/lib/indexing/graph-lite/llm-extract.test.ts packages/server/src/lib/queue/task-queue.test.ts packages/server/src/lib/lifecycle/outbox.test.ts packages/server/src/lib/lifecycle/subscribers/subscribers-integration.test.ts packages/server/src/routes/candidates.test.ts",
    "test:deployment-smoke": "vitest run packages/server/src/config.test.ts packages/server/src/app.test.ts packages/server/src/bootstrap/startup.test.ts packages/server/src/lib/runtime/deployment-profile.test.ts packages/server/src/lib/runtime/service-topology.test.ts packages/cli/src/lib/http.test.ts packages/cli/src/commands/auth.test.ts packages/cli/src/commands/retrieval.test.ts",
    "test": "vitest run",
    "test:file": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-vitest-file.ts",
    "test:coverage": "vitest run --coverage --reporter=default --silent=true",
    "typecheck": "tsc -b --pretty false",
    "eval": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/run-eval.ts",
    "eval:retrieval": "pnpm run eval -- retrieval",
    "eval:retrieval:smoke": "pnpm run eval -- retrieval --tier smoke",
    "eval:retrieval:core": "pnpm run eval -- retrieval --tier core",
    "eval:retrieval:dry-run": "pnpm run eval -- retrieval --tier smoke --dry-run",
    "eval:summary": "pnpm run eval -- summary",
    "eval:summary:smoke": "pnpm run eval -- summary --tier smoke",
    "eval:summary:core": "pnpm run eval -- summary --tier core",
    "eval:summary:dry-run": "pnpm run eval -- summary --tier smoke --dry-run",
    "eval:agent-planning": "pnpm run eval -- agent-planning --tier smoke",
    "eval:agent-planning:smoke": "pnpm run eval -- agent-planning --tier smoke --dry-run",
    "eval:agent-planning:core": "pnpm run eval -- agent-planning --tier core --dry-run",
    "eval:agent-planning:dry-run": "pnpm run eval -- agent-planning --tier smoke --dry-run",
    "eval:label-alignment": "pnpm run eval -- label-alignment --tier smoke --mode live",
    "eval:label-alignment:smoke": "pnpm run eval -- label-alignment --tier smoke --mode dry-run",
    "eval:label-alignment:core": "pnpm run eval -- label-alignment --tier core --mode dry-run",
    "eval:label-alignment:dry-run": "pnpm run eval -- label-alignment --tier smoke --mode dry-run",
    "eval:smoke": "pnpm run eval -- smoke",
    "eval:graph-extraction": "pnpm run eval -- graph-extraction",
    "eval:graph-extraction:smoke": "pnpm run eval -- graph-extraction --tier smoke",
    "eval:graph-extraction:dry-run": "pnpm run eval -- graph-extraction --tier smoke --dry-run",
    "eval:dedup": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/dedup-eval.ts",
    "eval:dedup:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/dedup-eval.ts --dry-run",
    "eval:conflict": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/conflict-eval.ts",
    "eval:conflict:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json evals/graph-extraction/conflict-eval.ts --dry-run",
    "eval:ingestion": "pnpm run eval -- ingestion",
    "eval:ingestion:smoke": "pnpm run eval -- ingestion --tier smoke",
    "eval:ingestion:dry-run": "pnpm run eval -- ingestion --tier smoke --dry-run",
    "eval:core": "pnpm run eval -- core",
    "eval:all": "pnpm run eval -- all --tier core",
    "eval:all:json": "pnpm run eval -- all --tier core --json --json-path ./reports/eval-report.json",
    "eval:ci": "pnpm exec tsx --tsconfig tsconfig.base.json evals/scripts/eval-ci.ts",
    "eval:ci:core": "TIER=core pnpm exec tsx --tsconfig tsconfig.base.json evals/scripts/eval-ci.ts",
    "eval:retrieval:snapshot:export": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/export-retrieval-db-snapshot.ts",
    "eval:retrieval:live": "pnpm exec tsx --tsconfig tsconfig.base.json evals/retrieval-live/run.ts",
    "eval:retrieval:live:smoke": "pnpm exec tsx --tsconfig tsconfig.base.json evals/retrieval-live/run.ts --tier smoke",
    "eval:retrieval:live:compare": "pnpm exec tsx --tsconfig tsconfig.base.json evals/retrieval-live/compare.ts",
    "download:skills": "pnpm exec tsx scripts/batch-download-skills.ts",
    "download:skills:dry": "pnpm exec tsx scripts/batch-download-skills.ts --dry-run --verbose",
    "test:import-export": "pnpm exec tsx scripts/test-skill-import-export.ts",
    "bench:store": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/bench-store.ts",
    "rag:analyze": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/rag-analyze.ts",
    "check:md-lint": "markdownlint-cli2 'docs/**/*.md' 'README.md' 'evals/**/*.md'",
    "check:links": "find docs evals -name '*.md' -not -path 'docs/archived/*' -not -path 'docs/plans/*' -not -path 'docs/superpowers/specs/*' -exec markdown-link-check {} +",
    "check:imports": "node scripts/check-relative-imports.mjs --only-cross-dir",
    "check:deps": "depcruise --config .dependency-cruiser.cjs packages/*/src",
    "docs:api": "typedoc",
    "codemod:relative": "FIX_IMPORTS_HEAP_MB=4096 bash scripts/codemod-batch.sh",
    "codemod:relative:dry": "bash scripts/codemod-batch.sh --dry",
    "deploy": "bash scripts/deploy.sh",
    "deploy:quick": "bash scripts/deploy-quick.sh",
    "backfill:labels": "pnpm exec tsx --tsconfig tsconfig.base.json packages/server/src/lib/labels/backfill-runner.ts",
    "backfill:labels:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json packages/server/src/lib/labels/backfill-runner.ts --dry-run",
    "label-merge:repair": "pnpm exec tsx --tsconfig tsconfig.base.json packages/server/src/lib/labels/merge-repair-runner.ts",
    "label-merge:repair:dry-run": "pnpm exec tsx --tsconfig tsconfig.base.json packages/server/src/lib/labels/merge-repair-runner.ts --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@trapmap/server": "workspace:*",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^18.0.0",
    "fallow": "^2.101.0",
    "fastify": "^5.6.1",
    "husky": "^9.1.7",
    "jscodeshift": "^17.3.0",
    "jsdom": "^29.1.1",
    "knip": "^6.4.1",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli2": "^0.22.1",
    "mermaid": "^11.15.0",
    "pg": "8.20.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
