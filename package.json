{
  "name": "trapmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "dev:cli": "pnpm --filter @trapmap/cli dev",
    "dev:server": "pnpm --filter @trapmap/server dev",
    "format": "biome format --write .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "eval:retrieval": "pnpm exec tsx evals/retrieval/run.ts",
    "eval:retrieval:smoke": "pnpm exec tsx evals/retrieval/run.ts --tier smoke",
    "eval:retrieval:core": "pnpm exec tsx evals/retrieval/run.ts --tier core",
    "eval:retrieval:dry-run": "pnpm exec tsx evals/retrieval/run.ts --tier smoke --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "knip": "^6.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
