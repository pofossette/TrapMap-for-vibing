{
  "name": "skill-shareer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "dev:cli": "pnpm --filter @skill-shareer/cli dev",
    "dev:server": "pnpm --filter @skill-shareer/server dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "pnpm -r run test",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
