#!/usr/bin/env sh

pnpm format || exit 1

# Refresh tracked files in the index so formatting changes are included.
git update-index --again || exit 1

pnpm check:imports || exit 1
pnpm check:asserts || exit 1
pnpm check:docs || exit 1

# Run fallow boundary and dependency check (fail only on critical new issues)
pnpm exec fallow list --boundaries --format json --quiet | grep -q '"configured": true' || {
  echo "Fallow boundaries not configured. Run 'fallow list --boundaries' to check."
  exit 1
}
