{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trapId": {
            "type": "string",
            "minLength": 1
          },
          "derivationUnitId": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "object",
            "properties": {
              "MATCH": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "GOAL": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "STRATEGY": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "AVOID": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "VERIFY": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["MATCH", "GOAL", "STRATEGY", "AVOID", "VERIFY"],
            "additionalProperties": false
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["trapId", "derivationUnitId", "sections", "contentHash", "sourceHash"],
        "additionalProperties": false
      }
    }
  },
  "required": ["results"],
  "additionalProperties": false,
  "title": "geneDeriveBatchResponse"
}
