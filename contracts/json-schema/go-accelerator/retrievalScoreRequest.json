{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "shortcut": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "scope",
          "labels",
          "requiredLevel",
          "shortcut",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "query": {
      "type": "string"
    },
    "filters": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "labels",
        "scopes"
      ],
      "additionalProperties": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "entries",
    "query",
    "filters"
  ],
  "additionalProperties": false,
  "title": "retrievalScoreRequest"
}
