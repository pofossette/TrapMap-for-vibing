# ============================================
# TrapMap - Production Environment
# ============================================
# Copy this file to .env and update values
# cp .env.production.example .env

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# --------------------------------------------
# Required API Keys
# --------------------------------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# --------------------------------------------
# Security
# --------------------------------------------
# Generate with: openssl rand -hex 32
TRAPMAP_SYSTEM_ADMIN_KEY=generate-with-openssl-rand-hex-32

# --------------------------------------------
# Data Storage
# --------------------------------------------
# PostgreSQL connection (recommended for production)
# When set, uses PostgreSQL instead of JSON file storage
# TRAPMAP_DATABASE_URL=postgresql://trapmap:password@postgres:5432/trapmap

# Data file path (fallback when TRAPMAP_DATABASE_URL is not set)
TRAPMAP_DATA_FILE=/app/.data/skill-shareer.json

# --------------------------------------------
# User Operations Logging (Phase 21)
# --------------------------------------------
# Enable user operations logging to files (default: false)
LOG_USER_OPS_ENABLED=false

# Directory for user ops log files (default: logs/user-ops)
# LOG_USER_OPS_DIR=logs/user-ops

# --------------------------------------------
# RAG Logging (Phase 22)
# --------------------------------------------
# Enable RAG retrieval logging to files (default: false)
LOG_RAG_ENABLED=false

# Directory for RAG log files (default: logs/rag)
# LOG_RAG_DIR=logs/rag

# --------------------------------------------
# Log Rotation (Phase 22)
# --------------------------------------------
# Maximum log file size in MB before rotation (default: 10)
# LOG_MAX_FILE_SIZE_MB=10

# Maximum number of backup files per day (default: 5)
# LOG_MAX_BACKUP_FILES=5

# --------------------------------------------
# AI Provider
# --------------------------------------------
# Provider: openai | openai-compatible | ollama | google-genai
# If not set, auto-detects from OPENAI_API_KEY or GEMINI_API_KEY
# AI_PROVIDER=openai

# API base URL (default varies by provider)
# AI_BASE_URL=https://api.openai.com/v1

# API key (default: OPENAI_API_KEY for openai provider)
# AI_API_KEY=sk-your-key-here

# Chat model (default: gpt-4o-mini for openai, llama3 for ollama)
# AI_CHAT_MODEL=gpt-4o-mini

# Embedding model (default: text-embedding-3-small for openai, nomic-embed-text for ollama)
# AI_EMBEDDING_MODEL=text-embedding-3-small

# Prompt provider selection (optional)
# Controls which template format and cache strategy is used.
# Valid values: anthropic, openai, deepseek, kimi, gemini, default
# If not set, auto-detected from model ID.
# AI_PROMPT_PROVIDER=anthropic

# System prompts use XML for semantic markup (四层架构).
# Template overrides via JSON file (AI_PROMPT_TEMPLATE_FILE).
# AI_PROMPT_TEMPLATE_FILE=/app/docs/reference/system-prompt-slots.default.json

# --------------------------------------------
# Separate Embedding Provider (optional)
# --------------------------------------------
# Use a different provider for embeddings than chat
# EMBEDDING_PROVIDER=google-genai
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_API_KEY=your-gemini-api-key
# EMBEDDING_MODEL=text-embedding-004
