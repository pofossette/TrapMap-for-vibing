# ============================================
# TrapMap - Production Environment
# ============================================
# Copy this file to .env and update values
# cp .env.production.example .env

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# --------------------------------------------
# Required API Keys
# --------------------------------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# --------------------------------------------
# Security
# --------------------------------------------
# Generate with: openssl rand -hex 32
TRAPMAP_SYSTEM_ADMIN_KEY=generate-with-openssl-rand-hex-32

# --------------------------------------------
# Data Storage
# --------------------------------------------
# Data file path (inside container)
TRAPMAP_DATA_FILE=/app/.data/trapmap.json

# --------------------------------------------
# Optional: Rate Limiting
# --------------------------------------------
# Max requests per minute (0 = unlimited)
# RATE_LIMIT_MAX=100

# --------------------------------------------
# Optional: CORS
# --------------------------------------------
# Allowed origins (comma-separated, * for all)
# CORS_ALLOWED_ORIGINS=*

# --------------------------------------------
# User Operations Logging (Phase 21)
# --------------------------------------------
# Enable user operations logging to files (default: false)
LOG_USER_OPS_ENABLED=false

# Directory for user ops log files (default: logs/user-ops)
# LOG_USER_OPS_DIR=logs/user-ops
