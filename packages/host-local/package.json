{
  "name": "@trapmap/host-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @trapmap/app-light dev",
    "start": "pnpm --filter @trapmap/app-light start",
    "test": "pnpm -C ../.. exec vitest run --project host-local --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@sentry/node": "^10.73.0",
    "@opentelemetry/api": "^1.9.0",
    "@trapmap/ai-providers": "workspace:*",
    "@trapmap/assembly": "workspace:*",
    "@trapmap/backend-core": "workspace:*",
    "@trapmap/contracts": "workspace:*",
    "@trapmap/infra": "workspace:*",
    "@trapmap/lib": "workspace:*",
    "@trapmap/service-candidate-ingestion": "workspace:*",
    "@trapmap/service-cron": "workspace:*",
    "@trapmap/service-governance-review": "workspace:*",
    "@trapmap/service-identity-access": "workspace:*",
    "@trapmap/service-job-runtime": "workspace:*",
    "@trapmap/service-knowledge-read": "workspace:*",
    "@trapmap/service-knowledge-write": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "langfuse": "3.38.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "vitest": "^5.0.0"
  }
}
