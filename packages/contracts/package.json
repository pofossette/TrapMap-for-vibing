{
  "name": "@trapmap/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evals": {
      "types": "./dist/domain/evals/index.d.ts",
      "import": "./dist/domain/evals/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm -C ../.. exec vitest run --project contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "graphology-operators": "^1.6.1",
    "graphology-shortest-path": "^2.1.0",
    "gray-matter": "^4.0.3",
    "mime-types": "^3.0.2",
    "zod": "^4.1.12"
  }
}
