{
  "name": "@trapmap/ai-providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-parse.js": {
      "types": "./dist/ai-parse.d.ts",
      "import": "./dist/ai-parse.js"
    },
    "./prompts.js": {
      "types": "./dist/prompts.d.ts",
      "import": "./dist/prompts.js"
    },
    "./prompts-knowledge.js": {
