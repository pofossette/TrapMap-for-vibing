{
  "name": "@trapmap/host-distributed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./config/*.js": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js"
    },
    "./gateway/*.js": {
      "types": "./dist/gateway/*.d.ts",
      "import": "./dist/gateway/*.js"
    },
    "./gateway/*": {
      "types": "./dist/gateway/*.d.ts",
      "import": "./dist/gateway/*.js"
    },
    "./shared/*.js": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:gateway": "tsx watch src/index.ts --service gateway",
    "dev:identity-access": "tsx watch src/index.ts --service identity-access",
    "dev:knowledge-read": "tsx watch src/index.ts --service knowledge-read",
    "dev:knowledge-write": "tsx watch src/index.ts --service knowledge-write",
    "dev:candidate-ingestion": "tsx watch src/index.ts --service candidate-ingestion",
    "dev:governance-review": "tsx watch src/index.ts --service governance-review",
    "dev:job-runtime": "tsx watch src/index.ts --service job-runtime",
    "start": "node dist/index.js",
    "start:gateway": "node dist/index.js --service gateway",
    "start:identity-access": "node dist/index.js --service identity-access",
    "start:knowledge-read": "node dist/index.js --service knowledge-read",
    "start:knowledge-write": "node dist/index.js --service knowledge-write",
    "start:candidate-ingestion": "node dist/index.js --service candidate-ingestion",
    "start:governance-review": "node dist/index.js --service governance-review",
    "start:job-runtime": "node dist/index.js --service job-runtime",
    "test:acceptance": "pnpm --filter @trapmap/service-identity-access build && pnpm --filter @trapmap/service-knowledge-read build && pnpm --filter @trapmap/service-knowledge-write build && pnpm --filter @trapmap/service-governance-review build && pnpm --filter @trapmap/service-candidate-ingestion build && pnpm --filter @trapmap/service-job-runtime build && pnpm -C ../.. exec vitest run --project host-distributed packages/host-distributed/src/identity-access/routes.test.ts packages/host-distributed/src/gateway/distributed-acceptance.test.ts packages/host-distributed/src/gateway/distributed-runtime-closeout.test.ts packages/host-distributed/src/gateway/internal-client.test.ts packages/host-distributed/src/shared/internal-knowledge-write-client.test.ts packages/host-distributed/src/governance-review/routes.test.ts packages/host-distributed/src/governance-review/delegation-acceptance.test.ts packages/host-distributed/src/candidate-ingestion/routes.test.ts packages/host-distributed/src/knowledge-write/routes.test.ts packages/host-distributed/src/job-runtime/ownership-acceptance.test.ts",
    "test": "pnpm -C ../.. exec vitest run --project host-distributed --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@trapmap/backend-core": "workspace:*",
    "@trapmap/contracts": "workspace:*",
    "@trapmap/service-identity-access": "workspace:*",
    "@trapmap/service-candidate-ingestion": "workspace:*",
    "@trapmap/service-governance-review": "workspace:*",
    "@trapmap/service-job-runtime": "workspace:*",
    "@trapmap/service-knowledge-read": "workspace:*",
    "@trapmap/service-knowledge-write": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "8.20.0",
    "vitest": "^3.2.1"
  }
}
