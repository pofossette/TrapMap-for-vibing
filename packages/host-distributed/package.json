{
  "name": "@trapmap/host-distributed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:gateway": "tsx watch src/index.ts --service gateway",
    "dev:identity-access": "tsx watch src/index.ts --service identity-access",
    "dev:knowledge-read": "tsx watch src/index.ts --service knowledge-read",
    "dev:knowledge-write": "tsx watch src/index.ts --service knowledge-write",
    "dev:candidate-ingestion": "tsx watch src/index.ts --service candidate-ingestion",
    "dev:governance-review": "tsx watch src/index.ts --service governance-review",
    "dev:job-runtime": "tsx watch src/index.ts --service job-runtime",
    "start": "node dist/index.js",
    "start:gateway": "node dist/index.js --service gateway",
    "start:identity-access": "node dist/index.js --service identity-access",
    "start:knowledge-read": "node dist/index.js --service knowledge-read",
    "start:knowledge-write": "node dist/index.js --service knowledge-write",
    "start:candidate-ingestion": "node dist/index.js --service candidate-ingestion",
    "start:governance-review": "node dist/index.js --service governance-review",
    "start:job-runtime": "node dist/index.js --service job-runtime",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trapmap/backend-core": "workspace:*",
    "@trapmap/client-core": "workspace:*",
    "@trapmap/contracts": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.15.4"
  }
}
