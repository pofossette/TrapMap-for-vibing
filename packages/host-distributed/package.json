{
  "name": "@trapmap/host-distributed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrate.js": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./config/*.js": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js"
    },
    "./gateway/*.js": {
      "types": "./dist/gateway/*.d.ts",
      "import": "./dist/gateway/*.js"
    },
    "./gateway/*": {
      "types": "./dist/gateway/*.d.ts",
      "import": "./dist/gateway/*.js"
    },
    "./shared/*.js": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./identity-access/*.js": {
      "types": "./dist/identity-access/*.d.ts",
      "import": "./dist/identity-access/*.js"
    },
    "./identity-access/*": {
      "types": "./dist/identity-access/*.d.ts",
      "import": "./dist/identity-access/*.js"
    },
    "./knowledge-read/*.js": {
      "types": "./dist/knowledge-read/*.d.ts",
      "import": "./dist/knowledge-read/*.js"
    },
    "./knowledge-read/*": {
      "types": "./dist/knowledge-read/*.d.ts",
      "import": "./dist/knowledge-read/*.js"
    },
    "./knowledge-write/*.js": {
      "types": "./dist/knowledge-write/*.d.ts",
      "import": "./dist/knowledge-write/*.js"
    },
    "./knowledge-write/*": {
      "types": "./dist/knowledge-write/*.d.ts",
      "import": "./dist/knowledge-write/*.js"
    },
    "./candidate-ingestion/*.js": {
      "types": "./dist/candidate-ingestion/*.d.ts",
      "import": "./dist/candidate-ingestion/*.js"
    },
    "./candidate-ingestion/*": {
      "types": "./dist/candidate-ingestion/*.d.ts",
      "import": "./dist/candidate-ingestion/*.js"
    },
    "./governance-review/*.js": {
      "types": "./dist/governance-review/*.d.ts",
      "import": "./dist/governance-review/*.js"
    },
    "./governance-review/*": {
      "types": "./dist/governance-review/*.d.ts",
      "import": "./dist/governance-review/*.js"
    },
    "./job-runtime/*.js": {
      "types": "./dist/job-runtime/*.d.ts",
      "import": "./dist/job-runtime/*.js"
    },
    "./cron-scheduler/*.js": {
      "types": "./dist/cron-scheduler/*.d.ts",
      "import": "./dist/cron-scheduler/*.js"
    },
    "./job-runtime/*": {
      "types": "./dist/job-runtime/*.d.ts",
      "import": "./dist/job-runtime/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @trapmap/app-distributed dev",
    "dev:gateway": "pnpm --filter @trapmap/app-distributed dev:gateway",
    "dev:identity-access": "pnpm --filter @trapmap/app-distributed start:identity-access",
    "dev:knowledge-read": "pnpm --filter @trapmap/app-distributed start:knowledge-read",
    "dev:knowledge-write": "pnpm --filter @trapmap/app-distributed start:knowledge-write",
    "dev:candidate-ingestion": "pnpm --filter @trapmap/app-distributed dev:candidate-ingestion",
    "dev:governance-review": "pnpm --filter @trapmap/app-distributed dev:governance-review",
    "dev:job-runtime": "pnpm --filter @trapmap/app-distributed dev:job-runtime",
    "start": "pnpm --filter @trapmap/app-distributed start",
    "start:gateway": "pnpm --filter @trapmap/app-distributed start:gateway",
    "start:identity-access": "pnpm --filter @trapmap/app-distributed start:identity-access",
    "start:knowledge-read": "pnpm --filter @trapmap/app-distributed start:knowledge-read",
    "start:knowledge-write": "pnpm --filter @trapmap/app-distributed start:knowledge-write",
    "start:candidate-ingestion": "pnpm --filter @trapmap/app-distributed start:candidate-ingestion",
    "start:governance-review": "pnpm --filter @trapmap/app-distributed start:governance-review",
    "start:job-runtime": "pnpm --filter @trapmap/app-distributed start:job-runtime",
    "test:acceptance": "pnpm --filter @trapmap/service-identity-access build && pnpm --filter @trapmap/service-knowledge-read build && pnpm --filter @trapmap/service-knowledge-write build && pnpm --filter @trapmap/service-governance-review build && pnpm --filter @trapmap/service-candidate-ingestion build && pnpm --filter @trapmap/service-job-runtime build && pnpm -C ../.. exec vitest run --project host-distributed packages/host-distributed/test/identity-access/routes.test.ts packages/host-distributed/test/gateway/distributed-acceptance.test.ts packages/host-distributed/test/gateway/distributed-runtime-closeout.test.ts packages/host-distributed/test/gateway/internal-client.test.ts packages/host-distributed/test/shared/internal-knowledge-write-client.test.ts packages/host-distributed/test/governance-review/routes.test.ts packages/host-distributed/test/governance-review/delegation-acceptance.test.ts packages/host-distributed/test/candidate-ingestion/routes.test.ts packages/host-distributed/test/knowledge-write/composition.test.ts packages/host-distributed/test/job-runtime/ownership-acceptance.test.ts",
    "test": "pnpm -C ../.. exec vitest run --project host-distributed --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@trapmap/assembly": "workspace:*",
    "@trapmap/backend-core": "workspace:*",
    "@trapmap/contracts": "workspace:*",
    "@trapmap/infra": "workspace:*",
    "@trapmap/service-candidate-ingestion": "workspace:*",
    "@trapmap/service-cron": "workspace:*",
    "@trapmap/service-governance-review": "workspace:*",
    "@trapmap/service-identity-access": "workspace:*",
    "@trapmap/service-job-runtime": "workspace:*",
    "@trapmap/service-knowledge-read": "workspace:*",
    "@trapmap/service-knowledge-write": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "8.20.0",
    "zod": "^4.3.6",
    "@trapmap/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "vitest": "^5.0.0"
  }
}
