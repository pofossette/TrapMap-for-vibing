{
  "name": "@trapmap/service-candidate-ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm -C ../.. exec tsc -p packages/service-candidate-ingestion/tsconfig.json",
    "test": "pnpm -C ../.. exec vitest run --project service-candidate-ingestion --passWithNoTests",
    "typecheck": "pnpm -C ../.. exec tsc -p packages/service-candidate-ingestion/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trapmap/ai-providers": "workspace:*",
    "@trapmap/backend-core": "workspace:*",
    "@trapmap/contracts": "workspace:*",
    "@trapmap/infra": "workspace:*",
    "@trapmap/lib": "workspace:*",
    "fastify": "^5.6.1",
    "drizzle-orm": "^0.45.2",
    "pg": "8.20.0",
    "zod": "^4.3.6",
    "@trapmap/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "reflect-metadata": "^0.2.2"
  }
}
