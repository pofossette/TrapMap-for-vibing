{
  "_template": "kimi",
  "_format": "json",
  "_doc": "Kimi/Moonshot prompt template. JSON format avoids XML parsing issues. Renderer: json-renderer.ts",
  "role": "{{role}}",
  "task": "{{task}}",
  "_if_corePrinciples": true,
  "principles": ["{{#list corePrinciples}}", "{{item}}", "{{/list}}"],
  "_if_outputInstructions": true,
  "output_format": ["{{#list outputInstructions}}", "{{item}}", "{{/list}}"],
  "_if_constraints": true,
  "rules": ["{{#list constraints}}", "{{item}}", "{{/list}}"],
  "_if_examples": true,
  "examples": ["{{#list examples}}", "{{item}}", "{{/list}}"]
}
