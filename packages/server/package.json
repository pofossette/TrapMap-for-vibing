{
  "name": "@trapmap/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./lib/*.js": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "graph-db:check": "tsx scripts/check-neo4j.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.1.39",
    "@langchain/openai": "^1.4.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@trapmap/ai-providers": "workspace:*",
    "@trapmap/backend-core": "workspace:*",
    "@trapmap/contracts": "workspace:*",
    "@trapmap/persistence-schema": "workspace:*",
    "@trapmap/service-knowledge-write": "workspace:*",
    "amqplib": "^0.10.8",
    "cockatiel": "^4.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "nanoid": "^5.1.6",
    "neo4j-driver": "^5.28.2",
    "pg": "8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "8.20.0",
    "drizzle-kit": "^0.31.10",
    "pg-mem": "^3.0.14"
  }
}
