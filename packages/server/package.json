{
  "name": "@trapmap/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "backfill-indexes": "tsx scripts/backfill-indexes.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.1.39",
    "@langchain/openai": "^1.4.4",
    "@trapmap/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "graphology-operators": "^1.6.1",
    "graphology-shortest-path": "^2.1.0",
    "nanoid": "^5.1.6",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.10",
    "pg-mem": "^3.0.14"
  }
}
