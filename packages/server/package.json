{
  "name": "@trapmap/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "backfill-indexes": "tsx scripts/backfill-indexes.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "dev": "RUNTIME_MODE=combined tsx watch src/index.ts",
    "dev:api": "RUNTIME_MODE=api tsx watch src/index.ts",
    "dev:local-agent": "TRAPMAP_DEPLOYMENT_PROFILE=local-agent RUNTIME_MODE=combined tsx watch src/index.ts",
    "dev:team-monolith": "TRAPMAP_DEPLOYMENT_PROFILE=team-monolith RUNTIME_MODE=combined tsx watch src/index.ts",
    "dev:gateway": "TRAPMAP_DEPLOYMENT_PROFILE=distributed TRAPMAP_DEPLOYMENT_PRESET=api RUNTIME_MODE=api tsx watch src/index.ts",
    "dev:distributed:gateway": "TRAPMAP_DEPLOYMENT_PROFILE=distributed TRAPMAP_DEPLOYMENT_PRESET=api RUNTIME_MODE=api tsx watch src/index.ts",
    "dev:candidate-worker": "TRAPMAP_DEPLOYMENT_PROFILE=distributed TRAPMAP_DEPLOYMENT_PRESET=candidate-worker RUNTIME_MODE=task-worker tsx watch src/worker.ts",
    "dev:distributed:candidate-worker": "TRAPMAP_DEPLOYMENT_PROFILE=distributed TRAPMAP_DEPLOYMENT_PRESET=candidate-worker RUNTIME_MODE=task-worker tsx watch src/worker.ts",
    "dev:governance-worker": "TRAPMAP_DEPLOYMENT_PROFILE=distributed TRAPMAP_DEPLOYMENT_PRESET=governance-worker RUNTIME_MODE=task-worker tsx watch src/worker.ts",
    "dev:distributed:governance-worker": "TRAPMAP_DEPLOYMENT_PROFILE=distributed TRAPMAP_DEPLOYMENT_PRESET=governance-worker RUNTIME_MODE=task-worker tsx watch src/worker.ts",
    "dev:distributed:outbox-worker": "TRAPMAP_DEPLOYMENT_PROFILE=distributed TRAPMAP_DEPLOYMENT_PRESET=outbox-worker RUNTIME_MODE=outbox-worker tsx watch src/worker.ts",
    "dev:task-worker": "RUNTIME_MODE=task-worker tsx watch src/worker.ts",
    "dev:outbox-worker": "RUNTIME_MODE=outbox-worker tsx watch src/worker.ts",
    "graph-db:benchmark-startup": "tsx --tsconfig ../../tsconfig.base.json scripts/benchmark-graph-backend.ts",
    "graph-db:check": "tsx scripts/check-neo4j.ts",
    "test": "vitest --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.1.39",
    "@langchain/openai": "^1.4.4",
    "@trapmap/contracts": "workspace:*",
    "amqplib": "^0.10.8",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "graphology-operators": "^1.6.1",
    "graphology-shortest-path": "^2.1.0",
    "nanoid": "^5.1.6",
    "neo4j-driver": "^5.28.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.10",
    "pg-mem": "^3.0.14"
  }
}
