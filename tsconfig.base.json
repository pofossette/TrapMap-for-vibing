{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@trapmap/ai-providers": ["./packages/ai-providers/src/index.ts"],
      "@trapmap/ai-providers/*": ["./packages/ai-providers/src/*"],
      "@trapmap/assembly": ["./packages/assembly/src/index.ts"],
      "@trapmap/assembly/*": ["./packages/assembly/src/*"],
      "@trapmap/backend-core": ["./packages/backend-core/src/index.ts"],
      "@trapmap/backend-core/*": ["./packages/backend-core/src/*"],
      "@trapmap/client-core": ["./packages/client-core/src/index.ts"],
      "@trapmap/client-core/*": ["./packages/client-core/src/*"],
      "@trapmap/contracts": ["./packages/contracts/src/index.ts"],
      "@trapmap/lib": ["./packages/lib/src/index.ts"],
      "@trapmap/lib/*": ["./packages/lib/src/*"],
      "@trapmap/contracts/*": ["./packages/contracts/src/*"],
      "@trapmap/infra": ["./packages/infra/src/index.ts"],
      "@trapmap/infra/*": ["./packages/infra/src/*"],
      "@trapmap/persistence-schema": ["./packages/persistence-schema/src/index.ts"],
      "@trapmap/persistence-schema/*": ["./packages/persistence-schema/src/*"],
      "@trapmap/service-identity-access": ["./packages/service-identity-access/src/index.ts"],
      "@trapmap/service-candidate-ingestion": [
        "./packages/service-candidate-ingestion/src/index.ts"
      ],
      "@trapmap/service-governance-review": ["./packages/service-governance-review/src/index.ts"],
      "@trapmap/service-job-runtime": ["./packages/service-job-runtime/src/index.ts"],
      "@trapmap/service-knowledge-read": ["./packages/service-knowledge-read/src/index.ts"],
      "@trapmap/service-knowledge-write": ["./packages/service-knowledge-write/src/index.ts"],
      "@trapmap/service-cron": ["./packages/service-cron/src/index.ts"],
      "@trapmap/host-distributed": ["./packages/host-distributed/src/index.ts"],
      "@trapmap/host-distributed/*": ["./packages/host-distributed/src/*"],
      "@trapmap/web-panel/*": ["./apps/web-panel/src/*"],
      "@trapmap/host-local": ["./packages/host-local/src/index.ts"],
      "@trapmap/host-local/*": ["./packages/host-local/src/*"],
      "@trapmap/cli": ["./apps/cli/src/index.ts"],
      "@trapmap/cli/*": ["./apps/cli/src/*"],
      "@trapmap/app-light": ["./apps/light/src/index.ts"],
      "@trapmap/app-light/*": ["./apps/light/src/*"],
      "@trapmap/app-distributed": ["./apps/distributed/src/index.ts"],
      "@trapmap/app-distributed/*": ["./apps/distributed/src/*"],
      "@trapmap/app-migration": ["./apps/migration/src/index.ts"],
      "@trapmap/app-migration/*": ["./apps/migration/src/*"],
      "@trapmap/db": ["./packages/db/src/index.ts"],
      "@trapmap/db/*": ["./packages/db/src/*"]
    }
  },
  "exclude": ["**/dist", "**/test", "**/__tests__", "coverage", "node_modules"]
}
