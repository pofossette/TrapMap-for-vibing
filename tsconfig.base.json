{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@trapmap/backend-core": ["./packages/backend-core/src/index.ts"],
      "@trapmap/client-core": ["./packages/client-core/src/index.ts"],
      "@trapmap/contracts": ["./packages/contracts/src/index.ts"],
      "@trapmap/contracts/evals": ["./packages/contracts/src/domain/evals/index.ts"],
      "@trapmap/contracts/*": ["./packages/contracts/src/*"],
      "@trapmap/service-identity-access": ["./packages/service-identity-access/src/index.ts"],
      "@trapmap/service-candidate-ingestion": [
        "./packages/service-candidate-ingestion/src/index.ts"
      ],
      "@trapmap/service-governance-review": ["./packages/service-governance-review/src/index.ts"],
      "@trapmap/service-job-runtime": ["./packages/service-job-runtime/src/index.ts"],
      "@trapmap/service-knowledge-write": ["./packages/service-knowledge-write/src/index.ts"],
      "@trapmap/web-panel/*": ["./packages/web-panel/src/*"],
      "@trapmap/host-local": ["./packages/host-local/src/index.ts"],
      "@trapmap/server/*": ["./packages/server/src/*"],
      "@trapmap/cli/*": ["./packages/cli/src/*"]
    }
  }
}
